		<Placemark id="4c5ae659_28E4588FB1DABAEB">
			<name>Hazardous Materials and Waste Storage Area</name>
			<description><![CDATA[<div><b>name</b>: Hazardous Materials and Waste Storage Area</div><div><b>description</b>: All hazardous materials used on-site are tracked and returned to the designated hazardous materials facility for final off-site disposal. The hazardous materials storage and waste containment facilities are located east and adjacent to the customer building. Hazardous materials and wastes are stored in storage sheds on paved surface.</div>]]></description>
			<styleUrl>#__managed_style_0F0B943E842C6E0634F3</styleUrl>
			<ExtendedData>
				<SchemaData schemaUrl="#__managed_schema">
					<SimpleData name="str:bmFtZQ==">Hazardous Materials and Waste Storage Area</SimpleData>
					<SimpleData name="str:ZGVzY3JpcHRpb24=">All hazardous materials used on-site are tracked and returned to the designated hazardous materials facility for final off-site disposal. The hazardous materials storage and waste containment facilities are located east and adjacent to the customer building. Hazardous materials and wastes are stored in storage sheds on paved surface.</SimpleData>
				</SchemaData>
			</ExtendedData>
			<Polygon>
				<outerBoundaryIs>
					<LinearRing>
