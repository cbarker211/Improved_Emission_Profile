				</gx:Image>
				<gx:Image kml:id="hosted_image_">
					<gx:ImageUrl>https://doc-14-c8-mymaps.googleusercontent.com/untrusted/hostedimage/sd36ussmpo1jl4lt45qrkmhk6s/qfnib6n3a17eh842pgp05htfog/1697461944750/Z7QpojEgf8eel7u0H5-EFIS_vO0IrWPx/09038157870710164734/5AJ9UNGrwyjdTQYDVhSbD7LE88At9r7CxRGbzdJBPdjAvdiYHFWWlRI7Hlhi5BY6CFCDW9I9X2I_P1UcaR0-61LggBZqp_qdnY4iSshc73K8O7UU6uC2PUg-RYodP1Abs0XYfRd_QmimptmzQp-13GtIv-PgOlmG10L4SiVWmAgT1b4ZX8rj4lr4QSqT3c12s?session=0&amp;fife=s{size}</gx:ImageUrl>
