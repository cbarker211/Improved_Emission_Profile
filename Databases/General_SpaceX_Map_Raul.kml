		<Placemark id="4c5ae659_28D7A341596B85DB">
			<name>Parking Area and Outdoor Storage</name>
			<description><![CDATA[<div><b>name</b>: Parking Area and Outdoor Storage</div><div><b>description</b>: Area 3 is located north of Area 1 on the northern portion of the Wilkie Site. Area 3 contains an outdoor storage area, cellular tower, a hazardous materials/waste storage area, parking area, minor vegetated landscaping, and a loading/unloading area. The outdoor storage contains miscellaneous equipment and
parts used during the manufacturing process, and recycled material collection bins. Hazardous material/waste is stored in two fenced and covered areas on the north side of the main warehouse building.</div>]]></description>
			<styleUrl>#__managed_style_0050D171312C6E0634CB</styleUrl>
			<ExtendedData>
				<SchemaData schemaUrl="#__managed_schema">
					<SimpleData name="str:bmFtZQ==">Parking Area and Outdoor Storage</SimpleData>
					<SimpleData name="str:ZGVzY3JpcHRpb24=">Area 3 is located north of Area 1 on the northern portion of the Wilkie Site. Area 3 contains an outdoor storage area, cellular tower, a hazardous materials/waste storage area, parking area, minor vegetated landscaping, and a loading/unloading area. The outdoor storage contains miscellaneous equipment and
parts used during the manufacturing process, and recycled material collection bins. Hazardous material/waste is stored in two fenced and covered areas on the north side of the main warehouse building.</SimpleData>
				</SchemaData>
			</ExtendedData>
