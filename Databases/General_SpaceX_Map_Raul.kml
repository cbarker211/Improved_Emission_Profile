		<Placemark id="4c5ae659_28D312E744357F5B">
			<name>PICA Laboratory Process area</name>
			<description><![CDATA[<div><b>name</b>: PICA Laboratory Process area</div><div><b>description</b>: Phenolic Infiltrated Carbon Ablative, or PICA, is a lightweight heat shield material used in the production of space transport vehicles. The PICA Laboratory Process area is located in Area 1 in between the Main Building and Building 3117.</div>]]></description>
			<styleUrl>#__managed_style_300BB4EA472C6E0634C6</styleUrl>
			<ExtendedData>
				<SchemaData schemaUrl="#__managed_schema">
					<SimpleData name="str:bmFtZQ==">PICA Laboratory Process area</SimpleData>
					<SimpleData name="str:ZGVzY3JpcHRpb24=">Phenolic Infiltrated Carbon Ablative, or PICA, is a lightweight heat shield material used in the production of space transport vehicles. The PICA Laboratory Process area is located in Area 1 in between the Main Building and Building 3117.</SimpleData>
				</SchemaData>
			</ExtendedData>
