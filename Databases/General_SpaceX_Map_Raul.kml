					</LinearRing>
				</outerBoundaryIs>
			</Polygon>
		</Placemark>
		<Placemark id="4c5ae659_28E45C3A78E5E0B6">
			<name>Warehouse Storage</name>
			<description><![CDATA[<div><b>name</b>: Warehouse Storage</div><div><b>description</b>: Building 816

The launch materials warehouse stores ground support hardware for rocket and payload integration. This storage area houses non-hazardous equipment that is not weatherproof.</div>]]></description>
			<styleUrl>#__managed_style_300BB4EA472C6E0634C6</styleUrl>
			<ExtendedData>
				<SchemaData schemaUrl="#__managed_schema">
					<SimpleData name="str:bmFtZQ==">Warehouse Storage</SimpleData>
					<SimpleData name="str:ZGVzY3JpcHRpb24=">Building 816

The launch materials warehouse stores ground support hardware for rocket and payload integration. This storage area houses non-hazardous equipment that is not weatherproof.</SimpleData>
				</SchemaData>
			</ExtendedData>
